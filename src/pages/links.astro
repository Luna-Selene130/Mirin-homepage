---
import Layout from "../Layouts/layout.astro";
import LinkCard from "../components/linkcard.astro";
---

<Layout
    title="Links | みりん星"
    pageTitle="リンク"
    pageDescription="よかったらのぞいていってください"
>
    <section>
        <h2>自分のリンク</h2>

        <div class="links">    
            <LinkCard
            name="みりん星のサイト"
            description="このサイトです"
            url="/"
            icon=""
            />
            
            <LinkCard
            name="Twitter"
            description="テキトーにつぶやいてます"
            url="https://x.com/Mirin_2468"
            icon=""
            />

            <LinkCard
            name="Github"
            description="たまーに更新する"
            url="https://github.com/Luna-Selene130"
            icon=""
            />
        </div>
    </section>

    <section>
        <h2>友達のリンク</h2>

        <div class="friend-links">
            <LinkCard
            name="トラマト"
            description="ホームページの作り方すごくわかりやすかった！！"
            url="https://toramutton.me/"
            icon="https://pbs.twimg.com/profile_images/2105642211652280320/thuGZmCW_400x400.jpg"
            />

            <LinkCard
            name="どらちゃん"
            description="色々教えるのがうまい人"
            url="https://natamoko.jp/"
            icon="https://pbs.twimg.com/profile_images/2031168610857832448/fgk793yE_400x400.jpg"
            />

            <LinkCard
            name="しぐれ"
            description="サカバンバスピスの人！アイコン描いたよ～"
            url="https://my-homepage-gules-six.vercel.app/"
            icon="https://pbs.twimg.com/profile_images/2112035114565951488/Qii4bEg6_400x400.jpg"
            />

            <LinkCard
            name="美羽"
            description="N科のアイドルオタクの人！"
            url="https://hiiragi-miu.com/"
            icon="https://pbs.twimg.com/profile_images/2059839943736999937/poh9X5jV_400x400.jpg"
            />

            <LinkCard
            name="アキラ(A-KIlA)"
            description="放送映像研究部の部長さん！"
            url="https://x.com/AKL_movediar"
            icon="https://pbs.twimg.com/profile_images/2034527042277158912/fPxhSSn8_400x400.jpg"
            />

            <LinkCard
            name="ばんぶー"
            description="一個下のN科アイドルオタクの人～"
            url="https://b4mboo.net/"
            icon="https://pbs.twimg.com/profile_images/2033930978935341056/RG6U0U4p_400x400.jpg"
            />

            <LinkCard
            name="スケプロ"
            description="由来はスケボーのプロらしい"
            url="https://x.com/yuuto_03_18"
            icon="https://pbs.twimg.com/profile_images/1435966793512747010/qgmDghmT_400x400.jpg"
            />

        </div>
    </section>

</Layout>

<style>
    section {
        margin-bottom: 50px;
    }

    .links {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap:15px;
    }

    .friend-links {
        display: grid;
        gap: 15px; 
    }

    @media (max-width: 700px) {
        .links {
            grid-template-columns: 1fr;
        }
    }
</style>
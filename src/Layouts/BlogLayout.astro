---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import '../styles/global.css'

interface Props {
	title: string;
	pageDescription?: string;
}

const { title, pageDescription } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={pageDescription ?? "みりん星のサイト"} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="icon" href="/images/Mirin.png" />
		<link
			href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body id="top">
		<Header />

		<main>
			<slot />
		</main>

		<Footer />
	</body>
</html>